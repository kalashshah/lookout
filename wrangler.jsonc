{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchword",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ring/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "watchword", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FRAMES", "bucket_name": "watchword-frames" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "AWS_REGION": "us-east-1", "MODEL_ID": "us.amazon.nova-2-lite-v1:0", "EMAIL_FROM": "alerts@info.rekkaai.com", "APP_URL": "http://localhost:5173" },
  "observability": { "enabled": true }
}
